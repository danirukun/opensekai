{
  "name": "opensekai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "check": "pnpm -r --if-present check && tsc --noEmit -p tsconfig.scripts.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "pnpm --filter @opensekai/output build && tsx scripts/prepare-output.ts && tsx scripts/prepare-tracking.ts && pnpm --filter @opensekai/desktop build",
    "dev:desktop": "pnpm build && pnpm --filter @opensekai/desktop tauri dev",
    "build:mac": "pnpm build && CARGO_PROFILE_RELEASE_STRIP=none pnpm --filter @opensekai/desktop tauri build --bundles app",
    "mcp": "tsx apps/mcp/src/cli.ts",
    "evaluate:smoke": "tsx tools/evaluation/src/run-smoke.ts",
    "evaluate:blueprints": "tsx tools/evaluation/src/run-blueprints.ts"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "@types/three": "0.180.0",
    "@types/pngjs": "6.0.5"
  }
}
