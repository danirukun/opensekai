{
  "name": "opensekai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "check": "pnpm -r --if-present check && tsc --noEmit -p tsconfig.scripts.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "ensure:ui": "tsx scripts/ensure-ui.ts",
    "build": "pnpm ensure:ui && pnpm --filter @opensekai/output build && tsx scripts/prepare-output.ts && tsx scripts/prepare-tracking.ts && pnpm --filter @opensekai/desktop build",
    "dev:desktop": "pnpm build && pnpm --filter @opensekai/desktop tauri dev",
    "build:mac": "pnpm build && CARGO_PROFILE_RELEASE_STRIP=none pnpm --filter @opensekai/desktop tauri build --bundles app",
    "mcp": "tsx apps/mcp/src/cli.ts",
    "evaluate:smoke": "tsx tools/evaluation/src/run-smoke.ts",
    "evaluate:blueprints": "tsx tools/evaluation/src/run-blueprints.ts",
    "evaluate:vmc-feed": "tsx tools/evaluation/src/vmc-feed.ts",
    "evaluate:tracking-feed": "tsx tools/evaluation/src/tracking-feed.ts",
    "build:test-stage": "tsx scripts/build-test-stage.ts",
    "build:lighting-stage": "mkdir -p fixtures/local/cache/lighting-stage && \"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --factory-startup --python-exit-code 1 --python scripts/lighting-stage/build_lighting_stage.py -- --out fixtures/local/cache/lighting-stage/lighting-stage.glb && tsx scripts/gltf-validate.ts fixtures/local/cache/lighting-stage/lighting-stage.glb"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
