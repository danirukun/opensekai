  "references": [
    {
      "id": "preview_main",
      "kind": "output",
      "name": "preview_main"
    },
    {
      "id": "camera_close",
      "kind": "camera",
      "name": "camera_close"
    },
    {
      "id": "camera_wide",
      "kind": "camera",
      "name": "camera_wide"
    }
