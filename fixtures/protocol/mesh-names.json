  {
   "name": "plain names in node order; a node without a mesh is skipped",
   "nodes": [
    {
     "name": "Body",
     "mesh": 0
    },
    {
     "name": "Armature"
    },
    {
     "name": "Face",
     "mesh": 1
    },
    {
     "name": "Hair",
     "mesh": 2
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Body"
    },
    {
     "node": 2,
     "name": "Face"
    },
    {
     "node": 3,
     "name": "Hair"
    }
   ]
  },
  {
   "name": "an empty name, a missing name, and a white-space name",
   "nodes": [
    {
     "name": "",
     "mesh": 0
    },
    {
     "mesh": 1
    },
    {
     "name": " \t\n\u00a0\u3000\ufeff",
     "mesh": 2
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Mesh 0"
    },
    {
     "node": 1,
     "name": "Mesh 1"
    },
    {
     "node": 2,
     "name": "Mesh 2"
    }
   ]
  },
  {
   "name": "the trim removes U+FEFF and keeps U+0085, as String.prototype.trim",
   "nodes": [
    {
     "name": "\ufeffHat\ufeff",
     "mesh": 0
    },
    {
     "name": "\u0085Cap",
     "mesh": 1
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Hat"
    },
    {
     "node": 1,
     "name": "\u0085Cap"
    }
   ]
  },
  {
   "name": "a trimmed name",
   "nodes": [
    {
     "name": "  Jacket  ",
     "mesh": 0
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Jacket"
    }
   ]
  },
  {
   "name": "repeated names get a number in node order",
   "nodes": [
    {
     "name": "Hair",
     "mesh": 0
    },
    {
     "name": "Hair",
     "mesh": 1
    },
    {
     "name": "Hair (2)",
     "mesh": 2
    },
    {
     "name": " Hair",
     "mesh": 3
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Hair"
    },
    {
     "node": 1,
     "name": "Hair (2)"
    },
    {
     "node": 2,
     "name": "Hair (2) (2)"
    },
    {
     "node": 3,
     "name": "Hair (3)"
    }
   ]
  },
  {
   "name": "a generated name that a later node also has",
   "nodes": [
    {
     "name": "",
     "mesh": 0
    },
    {
     "name": "Mesh 0",
     "mesh": 1
    }
   ],
   "expected": [
    {
     "node": 0,
     "name": "Mesh 0"
    },
    {
     "node": 1,
     "name": "Mesh 0 (2)"
    }
   ]
  },
  {
   "name": "a 129-unit name is cut; a repeat cuts the base before the suffix",
