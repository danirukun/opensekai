{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Local editor connection and fixed editor hiding",
  "windows": [
    "editor"
  ],
  "permissions": [
    "allow-app-version",
    "allow-editor-connection",
    "allow-hide-editor",
    "allow-import-avatar",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to"
  ]
}
