{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Local editor connection and fixed editor hiding",
  "windows": [
    "editor"
  ],
  "permissions": [
    "allow-app-version",
    "allow-editor-connection",
    "allow-hide-editor",
    "allow-set-keystroke-capture",
    "allow-open-input-monitoring-settings",
    "allow-open-screenshots-folder",
    "allow-show-scene",
    "allow-import-avatar",
    "allow-import-scene",
    "allow-save-show",
    "allow-save-show-as",
    "allow-open-show",
    "allow-set-show-dirty",
    "allow-confirm-close-editor",
    "allow-import-blueprint-file",
    "allow-export-blueprint-file",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to"
  ]
}
