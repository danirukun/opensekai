{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local scene owner and editor",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-version",
    "allow-bootstrap-session",
    "allow-shutdown-session",
    "allow-set-keystroke-capture",
    "allow-open-input-monitoring-settings",
    "allow-open-screenshots-folder",
    "allow-import-avatar",
    "allow-import-scene",
    "allow-import-image",
    "allow-import-video",
    "allow-capture-source-list",
    "allow-capture-source-allow",
    "allow-open-capture-settings",
    "allow-facekit-camera-list",
    "allow-open-camera-settings",
    "allow-save-show",
    "allow-save-show-as",
    "allow-open-show",
    "allow-recent-show-list",
    "allow-open-recent-show",
    "allow-commit-show-open",
    "allow-show-template-list",
    "allow-open-show-template",
    "allow-set-show-dirty",
    "allow-import-blueprint-file",
    "allow-export-blueprint-file",
    "allow-take-blueprint-link",
    "allow-finish-blueprint-link",
    "allow-open-help",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme"
  ]
}
